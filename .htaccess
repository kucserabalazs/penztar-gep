# Penztar-gep.hu – gyorsítás és keresőoptimalizálás (Apache tárhelyhez)
# Minden blokk feltételes: ha a tárhely nem ismeri az adott modult, egyszerűen kimarad.

DirectoryIndex index.html index.php
AddDefaultCharset utf-8
AddType image/webp .webp
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest

# ---- HTTPS és egységes cím (www nélkül) -------------------------------------
# Akkor kapcsolja be (a # jelek törlésével), ha a tárhelyen már működik az SSL
# tanúsítvány (https://penztar-gep.hu megnyílik lakat ikonnal). Így a Google
# egyetlen címet indexel, nem négyet (http/https, www/www nélkül).
#<IfModule mod_rewrite.c>
#  RewriteEngine On
#  RewriteCond %{HTTPS} !=on [OR]
#  RewriteCond %{HTTP_HOST} ^www\. [NC]
#  RewriteRule ^ https://penztar-gep.hu%{REQUEST_URI} [L,R=301]
#</IfModule>

# ---- Tömörítés ----------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# ---- Böngésző-gyorsítótár -------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 week"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# ---- Biztonsági fejlécek -----------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---- A régi weboldal címeinek átirányítása ------------------------------------------
# A Google még a régi (feltört, idegen linkeket tartalmazó) oldal címeit is ismeri
# (pl. /fooldal/, /kapcsolat/, /tudnivalok/). Ezek végleges (301) átirányítást kapnak az új
# oldal megfelelő részére, így a Google a régi tartalmat lecseréli az újra.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^fooldal/?$ https://penztar-gep.hu/ [R=301,L]
  RewriteRule ^(kapcsolat|elerhetoseg|elerhetosegek|kapcsolatfelvetel)/?$ https://penztar-gep.hu/#kapcsolat [R=301,NE,L]
  RewriteRule ^(tudnivalok|aszf|szallitas|szallitasi-feltetelek|szallitas-es-fizetes|vasarlasi-feltetelek)/?$ https://penztar-gep.hu/webaruhaz/#aszf [R=301,NE,L]
  RewriteRule ^(adatkezeles|adatvedelem|adatkezelesi-tajekoztato)/?$ https://penztar-gep.hu/webaruhaz/#adatkezeles [R=301,NE,L]
  RewriteRule ^(szerviz|javitas)/?$ https://penztar-gep.hu/webaruhaz/#szerviz [R=301,NE,L]
  # Régi WordPress-mappák: véglegesen megszűntek
  RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json)(/|$) - [G,L]
  RewriteRule ^(wp-login\.php|xmlrpc\.php)$ - [G,L]
  # Régi ?p=123 / ?page_id=123 típusú címek a főoldalra
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|product|product_cat)=
  RewriteRule ^(index\.php)?$ https://penztar-gep.hu/ [R=301,QSD,L]
  # Minden egyéb, már nem létező régi „/valami/” cím a webáruházba
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^[^/.]+(/[^/.]+)*/$ https://penztar-gep.hu/webaruhaz/ [R=301,L]
</IfModule>

# ---- Belső mappák elrejtése ---------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(mentesek|referencia|eszkozok)(/|$) - [F,L]
  RewriteRule (^|/)\.git(/|$) - [F,L]
</IfModule>
<IfModule mod_authz_core.c>
  <FilesMatch "\.(md|py|lock|bak)$">
    Require all denied
  </FilesMatch>
</IfModule>
